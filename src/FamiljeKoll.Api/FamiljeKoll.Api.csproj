<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FamiljeKoll.Service\FamiljeKoll.Service.csproj" />
    <ProjectReference Include="..\FamiljeKoll.Repository\FamiljeKoll.Repository.csproj" />
    <ProjectReference Include="..\FamiljeKoll.Domain\FamiljeKoll.Domain.csproj" />
    <ProjectReference Include="..\FamiljeKoll.ServiceDefaults\FamiljeKoll.ServiceDefaults.csproj" />
  </ItemGroup>
<!-- Release builds/publishes (e.g. Rider "Publish") also build the React app and publish it as wwwroot. -->
  <Target Name="PublishFrontend" BeforeTargets="AssignTargetPaths"
          Condition="'$(Configuration)' == 'Release' And '$(SkipFrontendBuild)' != 'true'">
    <PropertyGroup>
      <FrontendDir>$(MSBuildThisFileDirectory)..\..\frontend\familjekoll-ui</FrontendDir>
    </PropertyGroup>
    <Exec Command="npm ci" WorkingDirectory="$(FrontendDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendDir)" />
    <ItemGroup>
    <FrontendDist Include="$(FrontendDir)\dist\**" />
    <Content Include="@(FrontendDist)" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
